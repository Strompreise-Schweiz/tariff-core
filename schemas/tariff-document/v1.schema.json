{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Strompreise-Schweiz/tariff-core/main/schemas/tariff-document/v1.schema.json",
  "title": "Yearly tariff document",
  "description": "VSE TariffSubmission (OpenAPI 1.0.1) with additive fields: tariffs[].id, prices.dynamic.sourceUrl, products and _meta. A consumer of the VSE format can read this file unchanged.",
  "type": "object",
  "required": [
    "dsoName",
    "dsoNumber",
    "tariffs",
    "products",
    "_meta"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "dsoName": {
      "type": "string",
      "minLength": 1
    },
    "dsoNumber": {
      "type": "integer",
      "minimum": 10000000000,
      "maximum": 99999999999
    },
    "tariffs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Tariff"
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Product"
      }
    },
    "_meta": {
      "type": "object",
      "description": "Additive. How the file was built: from which files of the utility, with which automatic repairs and which corrections. The checks are in data/checks.json.",
      "required": [
        "schemaVersion",
        "vseVersion",
        "generator",
        "year",
        "pricesExcludeVat",
        "source",
        "repairs",
        "corrections"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "vseVersion": {
          "type": "string"
        },
        "generator": {
          "type": "object",
          "required": [
            "name",
            "version",
            "url"
          ]
        },
        "year": {
          "type": "integer"
        },
        "pricesExcludeVat": {
          "const": true
        },
        "source": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "sha256"
            ]
          }
        },
        "repairs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "detail",
              "count"
            ]
          }
        },
        "corrections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "action",
              "reason"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "Tariff": {
      "type": "object",
      "required": [
        "id",
        "tariffName",
        "tariffType",
        "tariffForm",
        "startDate",
        "endDate",
        "customerType",
        "prices"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Additive. Stable key, because tariffName is not unique in real files."
        },
        "customerVoltageLevel": {
          "type": "integer",
          "minimum": 2,
          "maximum": 7
        },
        "standardBasegroup": {
          "type": "boolean",
          "default": false
        },
        "tariffName": {
          "type": "string",
          "minLength": 1
        },
        "tariffType": {
          "enum": [
            "electricity",
            "grid",
            "metering",
            "regional_fees"
          ]
        },
        "tariffForm": {
          "enum": [
            "constant",
            "multilevel",
            "dynamic"
          ]
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "comment": {
          "type": "string"
        },
        "customerType": {
          "type": "string"
        },
        "prices": {
          "$ref": "#/$defs/Prices"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tariffForm": {
                "const": "dynamic"
              }
            }
          },
          "then": {
            "properties": {
              "prices": {
                "required": [
                  "dynamic"
                ]
              }
            }
          }
        }
      ]
    },
    "Prices": {
      "type": "object",
      "properties": {
        "base": {
          "$ref": "#/$defs/SimplePrice"
        },
        "energy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeBasedPrice"
          }
        },
        "power": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeBasedPrice"
          }
        },
        "reactivePower": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeBasedPrice"
          }
        },
        "refundStorage": {
          "$ref": "#/$defs/SimplePrice"
        },
        "dynamic": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "description": "The day prices of this tariff as published by this project, tariffs/current/<id>.json. The URL of the utility if no price source is configured for it."
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri",
              "description": "Additive. The API of the utility, as in its own file."
            }
          }
        },
        "municipalityTaxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MunicipalityTaxPrice"
          }
        },
        "cantonalTaxes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CantonalTaxPrice"
          }
        }
      }
    },
    "SimplePrice": {
      "type": "object",
      "required": [
        "price",
        "priceUnit"
      ],
      "properties": {
        "price": {
          "type": "number",
          "minimum": 0
        },
        "priceUnit": {
          "enum": [
            "CHF/kWh",
            "CHF/kW",
            "CHF/kW/M",
            "CHF/kW/Y",
            "CHF/kVarh",
            "CHF/M",
            "CHF"
          ]
        }
      }
    },
    "TimeBasedPrice": {
      "type": "object",
      "required": [
        "from",
        "to",
        "price",
        "priceUnit"
      ],
      "properties": {
        "months": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "enum": [
              "Jan",
              "Feb",
              "Mar",
              "Apr",
              "May",
              "Jun",
              "Jul",
              "Aug",
              "Sep",
              "Oct",
              "Nov",
              "Dec"
            ]
          }
        },
        "weekdays": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "enum": [
              "Mo",
              "Tu",
              "We",
              "Th",
              "Fr",
              "Sa",
              "Su"
            ]
          }
        },
        "from": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "to": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "price": {
          "type": "number",
          "minimum": 0
        },
        "priceUnit": {
          "enum": [
            "CHF/kWh",
            "CHF/kW",
            "CHF/kW/M",
            "CHF/kW/Y",
            "CHF/kVarh",
            "CHF/M",
            "CHF"
          ]
        }
      }
    },
    "MunicipalityTaxPrice": {
      "type": "object",
      "required": [
        "municipalityNumber",
        "municipalityName"
      ],
      "properties": {
        "municipalityNumber": {
          "type": "integer",
          "minimum": 1
        },
        "municipalityName": {
          "type": "string"
        },
        "municipalityBase": {
          "$ref": "#/$defs/SimplePrice"
        },
        "municipalityEnergy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeBasedPrice"
          }
        },
        "municipalityComment": {
          "type": "string"
        }
      }
    },
    "CantonalTaxPrice": {
      "type": "object",
      "required": [
        "cantonName"
      ],
      "properties": {
        "cantonName": {
          "enum": [
            "AG",
            "AI",
            "AR",
            "BE",
            "BL",
            "BS",
            "FR",
            "GE",
            "GL",
            "GR",
            "JU",
            "LU",
            "NE",
            "NW",
            "OW",
            "SG",
            "SH",
            "SO",
            "SZ",
            "TG",
            "TI",
            "UR",
            "VD",
            "VS",
            "ZG",
            "ZH"
          ]
        },
        "cantonBase": {
          "$ref": "#/$defs/SimplePrice"
        },
        "cantonEnergy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TimeBasedPrice"
          }
        },
        "cantonComment": {
          "type": "string"
        }
      }
    },
    "Product": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status",
        "components"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "suggested",
            "verified"
          ],
          "description": "verified when no component is suggested: each comes from standardBasegroup, is the only tariff of its type, or was checked by a person against sourceUrl."
        },
        "default": {
          "type": "boolean",
          "description": "The standard product of a household in the basic supply: what it gets without choosing anything. At most one per year."
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string"
        },
        "components": {
          "type": "object",
          "required": [
            "electricity",
            "grid"
          ],
          "additionalProperties": false,
          "properties": {
            "electricity": {
              "$ref": "#/$defs/ProductComponent"
            },
            "grid": {
              "$ref": "#/$defs/ProductComponent"
            },
            "metering": {
              "$ref": "#/$defs/ProductComponent"
            },
            "regional_fees": {
              "$ref": "#/$defs/ProductComponent"
            }
          }
        },
        "selection": {
          "type": "object",
          "required": [
            "kind",
            "value"
          ],
          "description": "Set when a customer must belong to a group to use this product, such as an EKZ grid cluster.",
          "properties": {
            "kind": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "howToFind": {
              "type": "string"
            }
          }
        }
      }
    },
    "ProductComponent": {
      "type": "object",
      "required": [
        "basis"
      ],
      "additionalProperties": false,
      "description": "One component of a product: the tariff in the total, where the choice comes from, and the options a customer may have instead.",
      "properties": {
        "tariff": {
          "type": "string",
          "description": "Id of the tariff in the total. Absent only for regional fees listed per municipality."
        },
        "basis": {
          "enum": [
            "standardBasegroup",
            "only",
            "curated",
            "suggested"
          ],
          "description": "standardBasegroup: the utility marks the tariff as standard (VSE 1.0.1). only: the yearly file has one tariff of this type for the voltage level. curated: a person chose it, see sourceUrl. suggested: not checked."
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Other tariffs of the same type a customer may have instead."
        },
        "howToFind": {
          "type": "string",
          "description": "How a customer finds out which option applies."
        },
        "byMunicipality": {
          "description": "regional_fees only: list the municipal fees of every municipality. An object limits them to tariffs with these names.",
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tariffNames": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
