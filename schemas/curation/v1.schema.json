{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Strompreise-Schweiz/tariff-core/main/schemas/curation/v1.schema.json",
  "title": "Manual corrections and product mapping (curation/<year>.json)",
  "description": "Everything a person changes in the data of a utility: corrections of the yearly file, corrections of day prices, products and accepted issues. Every correction needs a reason, so the published files stay traceable.",
  "type": "object",
  "required": [
    "year"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "year": {
      "type": "integer"
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "match",
          "set",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "match": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "tariffName": {
                "type": "string"
              },
              "tariffType": {
                "type": "string"
              },
              "customerVoltageLevel": {
                "type": "integer"
              },
              "customerType": {
                "type": "string"
              }
            }
          },
          "set": {
            "type": "object",
            "description": "Keys may be dotted, e.g. prices.energy."
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "removeTariffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "match",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "match": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "tariffName": {
                "type": "string"
              },
              "tariffType": {
                "type": "string"
              },
              "customerVoltageLevel": {
                "type": "integer"
              },
              "customerType": {
                "type": "string"
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "addTariffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tariff",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "tariff": {
            "type": "object"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "prices": {
      "type": "array",
      "description": "Corrections of day prices. Each replaces whole components in every interval of the days from to to, in this year.",
      "items": {
        "type": "object",
        "required": [
          "prices",
          "set",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "prices": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Id of the price source in config/source.json."
          },
          "from": {
            "type": "string",
            "format": "date"
          },
          "to": {
            "type": "string",
            "format": "date"
          },
          "set": {
            "type": "object",
            "minProperties": 1,
            "description": "Component name, such as grid or metering, and its prices.",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "unit",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "unit": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "products": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CuratedProduct"
      }
    },
    "acceptIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "tariff": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "CuratedProduct": {
      "type": "object",
      "required": [
        "id",
        "name",
        "components"
      ],
      "description": "A product. A component is a tariff id, or an object as in the yearly file whose basis is derived when absent: standardBasegroup, only, or suggested. status verified: a person checked every other component, which then becomes curated and needs sourceUrl.",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "suggested",
            "verified"
          ]
        },
        "default": {
          "type": "boolean",
          "description": "The standard product of a household in the basic supply: what it gets without choosing anything. At most one per year."
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string"
        },
        "selection": {
          "$ref": "../tariff-document/v1.schema.json#/$defs/Product/properties/selection"
        },
        "components": {
          "type": "object",
          "required": [
            "electricity",
            "grid"
          ],
          "additionalProperties": false,
          "properties": {
            "electricity": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/CuratedComponent"
                }
              ]
            },
            "grid": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/CuratedComponent"
                }
              ]
            },
            "metering": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/CuratedComponent"
                }
              ]
            },
            "regional_fees": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/CuratedComponent"
                }
              ]
            }
          }
        }
      }
    },
    "CuratedComponent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tariff": {
          "type": "string"
        },
        "basis": {
          "enum": [
            "standardBasegroup",
            "only",
            "curated",
            "suggested"
          ]
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "howToFind": {
          "type": "string"
        },
        "byMunicipality": {
          "$ref": "../tariff-document/v1.schema.json#/$defs/ProductComponent/properties/byMunicipality"
        }
      }
    }
  }
}
