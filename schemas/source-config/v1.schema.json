{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Strompreise-Schweiz/tariff-core/main/schemas/source-config/v1.schema.json",
  "title": "Where the data of a utility comes from (config/source.json)",
  "type": "object",
  "required": [
    "slug",
    "name",
    "vse_id",
    "tariffs",
    "prices"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "country": {
      "const": "CH"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "vse_id": {
      "type": "string",
      "pattern": "^CH\\d{11}$"
    },
    "elcom_id": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of the grid operator at ElCom, as in https://energy.ld.admin.ch/elcom/electricityprice/operator/<elcom_id>. One operator can have several VSE identifiers."
    },
    "data_license": {
      "type": "string"
    },
    "tariffs": {
      "type": "array",
      "description": "The yearly tariff files of the utility, in the VSE format. Stored unchanged in data/sources/<name>.json.",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "oneOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "file"
            ]
          }
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "file": {
            "type": "string",
            "description": "Hand-written file in VSE format in this repo, for a utility without a usable publication."
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "prices": {
      "type": "array",
      "description": "The APIs with day prices (HDN 2025, chapter 7.4). Each response is stored unchanged in data/sources/days/<id>/<year>/<date>.json and published under each dynamic tariff of the yearly file whose prices.dynamic.url is this API: data/tariffs/<year>/<tariff>/<date>.json.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$",
            "description": "Stable name, part of the folder data/sources/days/<id>/ and of corrections in curation."
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "As in prices.dynamic.url of the yearly file, with tariff_name. That is how a dynamic tariff finds its prices. start_timestamp and end_timestamp are added per day."
          },
          "enabled": {
            "type": "boolean",
            "default": true,
            "description": "false: no longer fetched. The stored days are still published."
          },
          "valid_from": {
            "type": "string",
            "format": "date"
          },
          "valid_to": {
            "type": "string",
            "format": "date"
          },
          "component_map": {
            "type": "object",
            "description": "Component names of the API mapped to those of HDN table 3, such as {\"dso\": \"grid\"}.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "backfill_days": {
            "type": "integer",
            "minimum": 0
          },
          "alert_after_hour": {
            "type": "integer",
            "minimum": 0,
            "maximum": 23
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
